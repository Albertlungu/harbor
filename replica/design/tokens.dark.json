  "radius": {
    "default": 0.28,
    "soft": 0.4,
    "round": 0.5,
    "card": 10,
    "popover": 14,
    "_note": "dock radii are fractions of bar thickness"
  },
  "shadow": {
    "dock": "0 8 24 rgba(0,0,0,.18)",
    "popover": "0 12 32 rgba(0,0,0,.22)"
