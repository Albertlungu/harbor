{
  "_about": "Harbor design tokens, light appearance. Manager and Settings use native macOS controls and semantic system colors; these tokens cover the custom surfaces: dock bar, labels, badges, indicators, popovers and widgets. Names are roles; replica-brand swaps values.",
  "color": {
    "bg": "#ffffff",
    "surface": "#f2f2f4",
    "dock-solid": "#e9e9ee",
    "border": "#d9d9de",
    "border-input": "#85858c",
    "text": "#1d1d1f",
    "text-muted": "#5f5f66",
    "label-bg": "#2b2b30",
    "on-label": "#ffffff",
    "accent": "#3a5ccc",
    "on-accent": "#ffffff",
    "indicator": "#3c3c43",
    "badge": "#d93a2f",
    "on-badge": "#ffffff",
    "danger": "#c62f2f",
    "success": "#1f7a4d",
    "warning": "#8a5a00",
    "focus": "#3a5ccc"
  },
  "pairs": [
    ["text", "bg"],
    ["text", "surface"],
    ["text", "dock-solid"],
    ["text-muted", "bg"],
    ["text-muted", "surface"],
    ["text-muted", "dock-solid"],
    ["on-label", "label-bg"],
    ["on-accent", "accent"],
    ["on-badge", "badge"],
    ["accent", "bg"],
    ["danger", "bg"],
    ["success", "bg"],
    ["warning", "bg"],
    ["border-input", "bg", "ui"],
    ["indicator", "dock-solid", "ui"],
    ["focus", "surface", "ui"]
  ],
  "font": {
    "sans": "system (SF Pro via NSFont.systemFont)",
    "rounded": "system rounded design",
    "mono": "system monospaced"
  },
  "type": {
    "badge": {"size": 11, "line": 13, "weight": 700},
    "label": {"size": 12, "line": 15, "weight": 500},
    "body": {"size": 13, "line": 16, "weight": 400},
    "title": {"size": 15, "line": 20, "weight": 600},
    "widget-lg": {"size": 20, "line": 24, "weight": 600}
  },
  "space": [0, 2, 4, 6, 8, 12, 16, 24, 32],
  "dock": {
    "icon-size": {"small": 32, "medium": 48, "large": 64, "min": 20, "max": 128},
    "thickness": {"thin": 0.15, "standard": 0.3, "thick": 0.5, "min": 24, "max": 200, "_note": "extra beyond icon size, as a fraction of icon size"},
    "spacing": {"tight": 2, "default": 6, "roomy": 12, "spacious": 20},
    "edge-gap": {"flush": 0, "small": 4, "medium": 10, "large": 20, "max": 64},
    "indicator": {"size": 4, "offset": 2},
    "magnification": {"default-scale": 1.6, "max-scale": 4.0, "falloff-icons": 2.5}
  },
  "radius": {"default": 0.28, "soft": 0.4, "round": 0.5, "card": 10, "popover": 14, "_note": "dock radii are fractions of bar thickness"},
  "shadow": {
    "dock": "0 8 24 rgba(0,0,0,.18)",
    "popover": "0 12 32 rgba(0,0,0,.22)"
  },
  "motion": {"fast": "120ms", "base": "220ms", "reveal": "180ms", "ease": "spring(response .3, damping .85)", "_note": "all motion collapses to crossfade or instant under Reduce Motion"}
}
